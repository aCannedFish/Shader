#version 120

/*
================================================================================
 shadow.fsh —— 阴影贴图片元着色器
================================================================================
 这个着色器【不输出任何颜色】，它的全部作用就是在深度写入之前
 决定"这个像素要不要被记录进阴影贴图"。

 只需要处理一种情况：镂空贴图（树叶、草、铁栏杆、栅栏）。
 如果不做 alpha 测试，一张正方形的树叶贴图会投下一个完整的方块影子，
 树底下就变成一块死黑 —— 这是新手最常遇到的阴影问题之一。

 注意：这里绝对不能 discard 掉"透明但仍在阴影贴图里"的像素之外的任何东西。
 每一片草叶都要能被正确记录，否则地面会出现一片一片的阴影空洞。
================================================================================
*/

#include "/settings.glsl"
#include "/lib/uniforms.glsl"

uniform sampler2D texture;

varying vec2 vTexCoord;
varying vec4 vColor;

void main() {
    vec4 albedo = texture2D(texture, vTexCoord) * vColor;

    // 半透明像素直接丢弃，不写深度，也就不会投射阴影。
    if (albedo.a < alphaTestRef) {
        discard;
    }

    // 没有颜色输出：阴影贴图只用到深度。
    // GPU 会自动把当前片元的 gl_FragCoord.z 写进深度附件。
}
